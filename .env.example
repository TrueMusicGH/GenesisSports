# Contact form email delivery (Gmail SMTP).
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: Google Account → Security → App passwords → Mail.
# 3. Copy these into a local `.env.local` file (never commit it) and into
#    your hosting provider's environment variables (e.g. Vercel → Settings → Environment Variables).

GMAIL_USER=sb@genesissports.co.in
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional — defaults to sb@genesissports.co.in
# CONTACT_TO=sb@genesissports.co.in
